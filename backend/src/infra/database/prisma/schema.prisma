generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  content     String
  category    String
  channel     String
  status      String    @default("pending")
  readAt      DateTime?
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bulkListId  String?
  bulkList    BulkList? @relation(fields: [bulkListId], references: [id])
  recipient   Recipient @relation(fields: [recipientId], references: [id])
}

model Recipient {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  status        String         @default("active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  bulkLists     BulkList[]     @relation("BulkListRecipients")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String
  textBody  String?
  variables String[]
  type      String   @default("EMAIL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bulkJobs  BulkNotificationJob[]
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  password             String
  name                 String
  role                 String                  @default("user")
  isVerified           Boolean                 @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  bulkLists            BulkList[]
  bulkJobs             BulkNotificationJob[]

  @@map("users")
}

model BulkList {
  id          String                  @id @default(uuid())
  name        String
  description String?
  filename    String?
  totalRecipients Int                 @default(0)
  processedRecipients Int             @default(0)
  status      String                  @default("pending") // pending, processing, completed, failed
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  recipients  Recipient[]             @relation("BulkListRecipients")
  notifications Notification[]
  jobs        BulkNotificationJob[]
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model BulkNotificationJob {
  id          String        @id @default(uuid())
  name        String
  description String?
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id])
  bulkListId  String?
  bulkList    BulkList?     @relation(fields: [bulkListId], references: [id])
  status      String        @default("pending") // pending, processing, completed, failed
  totalRecipients Int       @default(0)
  processedRecipients Int   @default(0)
  successCount Int          @default(0)
  failureCount Int          @default(0)
  variables   Json?         // Store template variables
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}